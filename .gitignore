# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Morph Expressive preview (web-only)
/preview/.dart_tool/
/preview/build/
/preview/.flutter-plugins-dependencies
/preview/android/
/preview/ios/
/preview/linux/
/preview/macos/
/preview/windows/

