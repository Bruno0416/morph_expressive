#!/usr/bin/env bash
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
CHECK="$ROOT/tool/ci/check_final_release_language.py"
checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote ref is not a source revision being pushed.
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  python3 "$ROOT/tool/ci/release_guard.py" check-local-context --revision "$local_sha"
  python3 "$CHECK" --revision "$local_sha" --ref "$local_ref" --ref "$remote_ref"
  checked=1
done
if [[ "$checked" -eq 0 ]]; then
  # Also works when the hook is invoked manually without Git's stdin.
  python3 "$ROOT/tool/ci/release_guard.py" check-local-context --revision HEAD
  python3 "$CHECK" --revision HEAD
fi
